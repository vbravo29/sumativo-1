        <mxCell id="repo" value="&lt;b&gt;Estructura y trazabilidad&lt;/b&gt;&lt;br/&gt;F1/ y F2/: notebooks por fase.&lt;br/&gt;src/: funciones reutilizables.&lt;br/&gt;data/raw/ → data/processed/.&lt;br/&gt;docs/ y evidencias/: respaldo.&lt;br/&gt;README: instalación y ejecución.&lt;br/&gt;.gitignore: excluir .venv y temporales." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#183044;align=left;verticalAlign=top;spacing=10;fillColor=#E8F3F0;strokeColor=#77A899;" vertex="1" parent="1">
