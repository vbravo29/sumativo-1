        <mxCell id="entorno" value="&lt;b&gt;Entorno reproducible&lt;/b&gt;&lt;br/&gt;Python 3.12 + .venv: aislar el entorno.&lt;br/&gt;requirements.txt: dependencias.&lt;br/&gt;pandas: leer y preparar datos.&lt;br/&gt;NumPy: operaciones numéricas." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fontColor=#183044;align=left;verticalAlign=top;spacing=10;fillColor=#E8F3F0;strokeColor=#77A899;" vertex="1" parent="1">
